# Copy this file to .env and fill in real values. Never commit .env.

# Required. Embeddings use OpenAI (text-embedding-3-small); the dialogue
# uses Anthropic (Claude Haiku 4.5).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides. Uncomment to change; leave commented for the defaults.
# (A blank `KEY=` line is loaded as an empty string, not as "unset".)
# Changing EMBEDDING_MODEL after indexing means re-running `socratese index`.
#EMBEDDING_MODEL=text-embedding-3-small
#DIALOGUE_MODEL=claude-haiku-4-5
